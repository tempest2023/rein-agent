{
  "name": "rein-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "browser:setup": "node scripts/agent-browser-dependency.mjs",
    "browser": "node scripts/agent-browser.mjs",
    "verify:browser": "node scripts/verify-agent-browser.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:discord-privacy": "node scripts/discord-privacy.mjs",
    "probe:discord-routing": "node scripts/probe-discord-routing.mjs",
    "verify:discord-isolation": "node scripts/verify-discord-isolation.mjs",
    "toolchain:pnpm": "npx --prefix .toolchain --no-install pnpm",
    "openclaw": "node scripts/openclaw.mjs",
    "setup:local": "node scripts/init-local.mjs",
    "upstream:update": "node scripts/update-openclaw.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "verify:proposal-tools": "node scripts/verify-proposal-tools.mjs",
    "smoke:gateway": "node scripts/smoke-gateway.mjs",
    "verify:slack-isolation": "node scripts/verify-slack-isolation.mjs"
  }
}
